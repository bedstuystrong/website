<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}{% if page.url != "/" %} | {{ site.title }}{% endif %}</title>
    <link rel="stylesheet" type="text/css" href="/style.css">
    {%- if custom_css %}<style type="text/css">{{ custom_css }}</style>{% endif -%}
    {% block head %}{% endblock %}
  </head>
  <body>
    <div class="banner">
      Bed-Stuy Strong is now Bed-Stuy Survival Collective.
      <a href="https://newsletter.bedstuystrong.com/2026-07-31-summer-party-rename/#bssc">
        Read more about this change in our newsletter</a>.
      The website will be updated soon.
    </div>
    <header>
      <h1>
        <a href="/">
          {% image "/logo.png", "Bed-Stuy Strong", 140 %}
        </a>
      </h1>
    </header>
    <main class="{% if flex_column %}flex-column{% endif %}">
      {{ content }}
    </main>
  </body>
</html>