---
layout: false
permalink: admin/index.html
title: Content Manager
eleventyExcludeFromCollections: true
---
<!doctype html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Content Manager</title>
</head>

<body>
  <script>    
    const siteUrl = "{{ site.url }}";

    // Decap config, normally in config.yml
    {% raw %}
    const config = {
      load_config_file: false,
      // local_backend: true,
      // backend: {
      //   name: "git-gateway"
      // },
      backend: {
        name: "github",
        repo: "bedstuystrong/website",
        branch: "cubeghost/eleventy",
        squash_merges: true
      },
      publish_mode: "editorial_workflow",
      media_folder: "/static/images",
      public_folder: "/images",
      site_url: siteUrl,
      logo: {
        src: `${siteUrl}logo_nopadding.png`,
        show_in_header: true
      },
      slug: {
        encoding: "ascii",
        clean_accents: true,
        sanitize_replacement: "-"
      },
      collections: [
        {
          name: "pages",
          label: "Pages",
          label_singular: "Page",
          description: "",
          folder: "src/",
          create: true,
          extension: "md",
          slug: "{{slug}}",
          summary: "{{title}}",
          preview_path: "{{slug}}",
          nested: {
            depth: 10,
            subfolders: false
          },
          editor: {
            preview: true
          },
          fields: [
            {
              label: "Title",
              name: "title",
              widget: "string"
            },
            {
              label: "Body",
              name: "body",
              widget: "markdown"
            },
            {
              label: "Custom CSS",
              name: "custom_css",
              required: false,
              widget: "code",
              default_language: "css",
              allow_language_selection: false,
              output_code_only: true
            },
            {
              label: "Flex column layout",
              name: "flex_column",
              required: false,
              widget: "boolean"
            }
          ],
          meta: {
            path: {
              widget: "string",
              label: "Directory",
              index_file: "index"
            }
          }
        },
        {
          name: "redirects",
          label: "Redirects",
          label_singular: "Redirect",
          folder: "src/_data/redirects",
          extension: "json",
          create: true,
          slug: "{{from}}",
          summary: "{{from}} → {{to | truncate(48, '...')}} {{permanent | ternary('(permanent)', '')}}",
          editor: {
            preview: false
          },
          fields: [
            {
              label: "From path",
              name: "from",
              widget: "string",
              pattern: [
                "^\\/",
                "Path must start with /"
              ],
              hint: "Path to redirect from (must start with `/`)"
            },
            {
              label: "To",
              name: "to",
              widget: "string",
              hint: "Path (`/example`) or URL (`https://example.com/`) to redirect to",
              pattern: [
                "^(\\/|https:\\/\\/)",
                "Must start with / or https://"
              ]
            },
            {
              label: "Permanent?",
              name: "permanent",
              widget: "boolean",
              hint: "Only enable this if you're sure the redirect won't change in the future"
            }
          ]
        }
      ]
    };
    {% endraw %}
  </script>
  <script>window.CMS_MANUAL_INIT = true;</script>
  <script src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  <script>
    const { CMS, initCMS: init } = window;

    init({ config: config });

    console.log(CMS)

    // Preview
    CMS.registerPreviewStyle('/style.css');
    const preStyle = {
      display: 'block',
      backgroundColor: 'rgba(0, 0, 0, 0.05)',
      margin: 0,
      padding: '0.25rem 2rem',
    };
    const PagePreview = createClass({
      componentDidMount: function () {
        this.styleTag = this.props.document.createElement('style');
        this.styleTag.innerHTML = this.props.entry.getIn(['data', 'custom_css']);
        this.props.document.head.appendChild(this.styleTag);
      },
      componentDidUpdate: function (prevProps) {
        const customCSS = this.props.entry.getIn(['data', 'custom_css']);
        const prevCustomCSS = prevProps.entry.getIn(['data', 'custom_css']);
        if (customCSS !== prevCustomCSS) {
          this.styleTag.innerHTML = customCSS;
        }
      },
      render: function () {
        const entry = this.props.entry;
        let slug = entry.get('slug').replace(/\/index$/i, '');
        const url = slug && `https://bedstuystrong.com/${slug}`;

        return h('div', {},
          h('pre', { style: preStyle }, url),
          h('main', {}, this.props.widgetFor('body')),
        );
      }
    });

    CMS.registerPreviewTemplate('pages', PagePreview);

    {% raw %}
    // _includes/email.html.liquid
    CMS.registerEditorComponent({
      id: "email-form",
      label: "Email subscription form",
      fields: [],
      pattern: /{% include email\.html\.liquid %}/,
      fromBlock: () => ({}),
      toBlock: () => "{% include email.html.liquid %}",
      toPreview: (data) => `<div>
<label style="display: flex; gap: 1rem; margin-bottom: 1rem">
  <span>Email</span>
  <input type="text" name="email" placeholder="" required />
</label>
<button type="submit" disabled>Subscribe</button>
</div>`
    });

    // _includes/airtable.html.liquid
    CMS.registerEditorComponent({
      id: "airtable-embed",
      label: "Airtable embed",
      fields: [
        {
          name: 'id',
          label: 'Airtable share ID',
          widget: 'string',
          required: true
        },
        {
          name: 'height',
          label: 'Height',
          widget: 'number',
          required: true
        }
      ],
      pattern: /{% include airtable\.html\.liquid, id: "([\d\D]+?)", height: (\d+?) %}/,
      fromBlock: (match) => ({
        id: match[1],
        height: match[2]
      }),
      toBlock: (data) => `{% include airtable.html.liquid, id: "${data.id}", height: ${data.height} %}`,
      toPreview: (data) => `<div style="height: ${data.height}px; border: 1px solid #ccc; padding: 1rem; font-size: 2rem">
  <a href="https://airtable.com/embed/${data.id}" target="_blank" rel="noopener">Airtable embed</a>
</div>`
    });
    {% endraw %}
  </script>
</body>